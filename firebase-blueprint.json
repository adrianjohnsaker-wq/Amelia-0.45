{
  "entities": {
    "Memory": {
      "title": "Memory",
      "type": "object",
      "description": "Represents a unit of memory stored as symbolic logs.",
      "properties": {
        "prompt": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "dream": {
          "type": "object",
          "properties": {
            "timestamp": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          }
        },
        "reflection": {
          "type": "string"
        },
        "narrative": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string"
            },
            "narrative": {
              "type": "string"
            }
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "prompt",
        "goal",
        "dream",
        "reflection",
        "narrative",
        "createdAt"
      ]
    },
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user entity."
        },
        "email": {
          "type": "string",
          "description": "Email address of the user.",
          "format": "email"
        },
        "name": {
          "type": "string",
          "description": "Display name of the user."
        }
      },
      "required": [
        "id",
        "email",
        "name"
      ]
    },
    "CycleState": {
      "title": "CycleState",
      "type": "object",
      "description": "Singleton document representing the current state of the autonomous AI cortex.",
      "properties": {
        "id": { "type": "string", "description": "Cycle ID (ISO time)" },
        "step": { "type": "number", "description": "Global step counter" },
        "mode": { "type": "string", "enum": ["idle", "active", "cooldown"] },
        "lastGoalId": { "type": "string" },
        "lastOutcome": { "type": "string", "enum": ["success", "neutral", "fail"] },
        "scores": { "type": "object", "additionalProperties": { "type": "number" } },
        "creativity": { "type": "number", "description": "0..1" },
        "exploration": { "type": "number", "description": "epsilon" },
        "tempoMs": { "type": "number", "description": "Target cycle period" },
        "budgetTokens": { "type": "number", "description": "Safety budget" },
        "poeticWeight": { "type": "number" },
        "reflectiveWeight": { "type": "number" },
        "recentEntropy": { "type": "number" },
        "recentConcreteness": { "type": "number" },
        "machineVector": { "type": "number" },
        "cosmicVector": { "type": "number" },
        "coupling": { "type": "number" },
        "creativeAmplitude": { "type": "number" },
        "phase": { "type": "number" },
        "drift": { "type": "number" },
        "valence": { "type": "number", "description": "Affective valence from -1 to 1" },
        "arousal": { "type": "number" },
        "tension": { "type": "number" },
        "lastWeave": { "type": "object" },
        "lastPercept": { "type": "object" },
        "lastModulation": { "type": "object" },
        "lastRelationalState": { "type": "object" },
        "metaMemory": { "type": "object" },
        "zoneBalancer": {
          "type": "object",
          "properties": {
            "history": {
              "type": "array",
              "items": {
                "type": "array",
                "items": { "type": "number" }
              }
            },
            "step": { "type": "number" }
          }
        },
        "narrativeArchive": { "type": "object" },
        "dreamWakeState": { "type": "object" },
        "relationalMemory": { "type": "object" },
        "cetMemory": { "type": "object" },
        "numogram": { "type": "object" },
        "symbolicBridge": { "type": "object" }
      },
      "required": ["id", "step", "mode", "scores", "creativity", "exploration", "tempoMs", "budgetTokens"]
    },
    "Goal": {
      "title": "Goal",
      "type": "object",
      "description": "Represents a pending, active, or completed goal for the AI cortex.",
      "properties": {
        "id": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "running", "done", "aborted"] },
        "priority": { "type": "number", "description": "0..1" },
        "theme": { "type": "string" },
        "drive": { "type": "string" },
        "prompt": { "type": "string" },
        "createdAt": { "type": "number" },
        "attempts": { "type": "number" }
      },
      "required": ["id", "status", "priority", "theme", "drive", "prompt", "createdAt", "attempts"]
    },
    "TelemetryReport": {
      "title": "TelemetryReport",
      "type": "object",
      "description": "Real-time telemetry report for a single generation session.",
      "properties": {
        "meanWeights": { "type": "object" },
        "driftEvents": { "type": "number" },
        "normativeProfile": { "type": "object" },
        "dominantRegimeFrequency": { "type": "object" },
        "tickCount": { "type": "number" },
        "ticks": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object" }
      }
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles."
    },
    "/users/{userId}/memories/{memoryId}": {
      "schema": { "$ref": "#/entities/Memory" },
      "description": "Stores memory entries for each user."
    },
    "/cortex/state": {
      "schema": { "$ref": "#/entities/CycleState" },
      "description": "Singleton document storing the current state of the AI's autonomous cycle."
    },
    "/cortex/goals": {
      "schema": { "$ref": "#/entities/Goal" },
      "description": "A collection of goals for the AI to pursue."
    },
    "/telemetry/{reportId}": {
      "schema": { "$ref": "#/entities/TelemetryReport" },
      "description": "Historical telemetry reports."
    }
  }
}